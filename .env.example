# ===== API 서버 (apps/api, FastAPI) =====
DATABASE_URL=mysql+pymysql://golf:golf@localhost:3306/golf?charset=utf8mb4
# 운영 API(API-15~17) 호출 키 (헤더 X-Admin-Key). 실서비스에서는 비밀 저장소로
ADMIN_KEY=change-me
# 외부 연동: mock = 가짜 연결 (메인 사이트 방식 확정 전, 질문 Q-14·Q-15)
AUTH_PROVIDER=mock
PAYMENT_PROVIDER=mock
# 안내 메일 (이 서비스가 직접 보냄): log = 보내지 않고 기록만 / smtp = 실제 발송. 실패해도 예약은 그대로, 결과는 notification 에 기록
MAIL_BACKEND=log
# 보내는 주소: TRAVENDER 홋카이도 사이트 도메인으로 새로 만들 예정 (확정 대기)
MAIL_FROM=
MAIL_FROM_NAME=TRAVENDER 홋카이도 골프
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# 고객센터 연락처 (메일·안내에 표시, 확정 대기). 운영 시간 10:00~17:00 은 코드에 있음
SUPPORT_TEL=
SUPPORT_EMAIL=
# 본 사이트가 부르는 API(API-19 고객 취소·환불 결과) 키 (헤더 X-Site-Key). 비우면 모두 거부. 실제 인증 방식은 결제 연동 협의 때
SITE_KEY=
# 오늘 날짜 고정 (테스트·데모용, 비우면 실제 날짜 JST)
FIXED_TODAY=
# 실행 환경: test (테스트 서버) | production (본 서버). 아직 동작 차이는 없음
APP_ENV=test

# ===== 화면 (apps/web) =====
# 서버 API 사용 (1) / 프로토타입처럼 브라우저 안 데이터 (비움)
# VITE_USE_API=1
# Google 지도 키는 apps/web/.env.local 에 VITE_GOOGLE_MAPS_API_KEY=...
