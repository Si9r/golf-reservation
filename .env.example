# ===== API 서버 (apps/api, FastAPI) =====
DATABASE_URL=mysql+pymysql://golf:golf@localhost:3306/golf?charset=utf8mb4
# 운영 API(API-15~17) 호출 키 (헤더 X-Admin-Key). 실서비스에서는 비밀 저장소로
ADMIN_KEY=change-me
# 본 사이트(TRAVENDER) 로그인·결제·환불 연동: fake = 가짜 본 사이트 (로컬 개발·테스트) / partner = 실제 본 사이트
PAYMENT_BACKEND=fake
# 본 사이트 Partner API 주소와 키 (값은 비워 두고 실제 값은 배포 환경에서만. 소스·채팅·이슈에 적지 않음)
PARTNER_API_BASE=
PARTNER_API_KEY=
# 본 사이트 로그인·로그아웃 주소 (로그인은 ?next=<골프 화면 경로> 를 붙여 보냄)
LOGIN_URL=/login
LOGOUT_URL=/logout
# 결제를 마치고 돌아올 골프 결과 화면 (본 사이트 주문의 return_url, 절대 주소, {no} = 예약번호)
PAYMENT_RETURN_URL=http://localhost:8787/#/golf/payment/return?no={no}
# 운영자 알림 메일 (환불 실패 · 출발 판정 실패). 비면 기록(notification OPS_ALERT)·로그만
OPS_EMAIL=
# 안내 메일 (이 서비스가 직접 보냄): smtp = 실제 발송 (팀 공용 Resend 계정) / log = 보내지 않고 기록만. 실패해도 예약은 그대로, 결과는 notification 에 기록
# SMTP_PASSWORD(Resend API 키)가 비어 있으면 발송은 실패(FAIL 기록)하므로, 키가 없으면 log 로 바꿔 쓰세요. 테스트(pytest)는 항상 log
MAIL_BACKEND=smtp
# 보내는 주소: 모든 메일(손님 안내·운영자 알림)을 이 주소로. SMTP 계정이 이 주소로 보낼 권한이 있어야 함 (도메인 SPF·DKIM)
# 지금은 테스트용 Resend 주소 (resend.dev 는 Resend 가입 주소로만 받을 수 있음). 실제 서비스 주소는 도메인 인증 후 바꿈
MAIL_FROM=golf-test@resend.dev
MAIL_FROM_NAME=TRAVENDER 홋카이도 골프
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USER=resend
# Resend API 키. git·채팅에 올리지 말 것 (팀원끼리 따로 전달)
SMTP_PASSWORD=
# 테스트 메일: python -m app.mail_samples <받는 주소>  (apps/api 에서, MAIL_BACKEND=smtp 일 때 실제 발송)
# 고객센터 연락처 (메일·안내에 표시, 확정 대기). 운영 시간 10:00~17:00 은 코드에 있음
SUPPORT_TEL=
SUPPORT_EMAIL=
# 본 사이트가 부르는 API(API-19 고객 취소·환불 결과) 키 (헤더 X-Site-Key). 비우면 모두 거부. 실제 인증 방식은 결제 연동 협의 때
SITE_KEY=
# 오늘 날짜 고정 (테스트·데모용, 비우면 실제 날짜 JST)
FIXED_TODAY=
# 실행 환경: test (테스트 서버) | production (본 서버). 아직 동작 차이는 없음
APP_ENV=test

# ===== 화면 (apps/web) =====
# 서버 API 사용 (1) / 프로토타입처럼 브라우저 안 데이터 (비움)
# VITE_USE_API=1
# Google 지도 키는 apps/web/.env.local 에 VITE_GOOGLE_MAPS_API_KEY=...
